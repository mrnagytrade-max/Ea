//@version=6
// ============================================================================
//  EGX Premium Signals  |  مؤشر الأسهم المصرية الاحترافي  —  Created By Arbah Markets
//  Multi-confirmation entry/exit signal system tuned for EGX-listed stocks.
//  Confluence: Trend (EMA stack + SuperTrend) + RMI + Momentum (MACD + RSI)
//              + Trend Strength (ADX) + Volume + Supply/Demand + FVG + Structure
//  Chart stays minimal by design (HMA trend ribbon + entry arrows only) —
//  every layer's detail surfaces in the dashboard instead of on the chart.
// ============================================================================
indicator("EGX Premium Signals | مؤشر الأسهم المصرية الاحترافي", shorttitle="EGX Pro", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ============================== INPUTS =====================================
grpTrend = "📈 الاتجاه — Trend"
emaFastLen = input.int(21,  "EMA سريع (Fast)",   minval=2, group=grpTrend)
emaMedLen  = input.int(55,  "EMA متوسط (Medium)", minval=2, group=grpTrend)
emaSlowLen = input.int(200, "EMA بطيء (Slow)",    minval=2, group=grpTrend)
stFactor   = input.float(3.0, "SuperTrend Factor", step=0.1, group=grpTrend, tooltip="يتحكم في حساسية خط الاتجاه المتحرك ووقف الخسارة")
stAtrLen   = input.int(10, "SuperTrend ATR Length", group=grpTrend)

grpRibbon = "🌈 الشريط اللوني — Trend Ribbon"
showRibbon      = input.bool(true, "إظهار الشريط اللوني الاحترافي", group=grpRibbon, tooltip="خط ملوّن أنعم يتتبع السعر بدل خط SuperTrend التقليدي")
ribbonLen       = input.int(21, "طول تجانس الشريط", minval=2, group=grpRibbon)
ribbonGlow      = input.bool(true, "تأثير التوهج (Glow)", group=grpRibbon)
ribbonWidth     = input.int(2, "سُمك الخط", minval=1, maxval=5, group=grpRibbon)
showSuperTrend  = input.bool(false, "إظهار خط SuperTrend التقليدي (متدرّج)", group=grpRibbon)

grpMom = "⚡ الزخم — Momentum"
rsiLen   = input.int(14, "فترة RSI", group=grpMom)
rsiOB    = input.int(70, "تشبع شرائي (Overbought)", group=grpMom)
rsiOS    = input.int(30, "تشبع بيعي (Oversold)", group=grpMom)
macdFast = input.int(12, "MACD Fast", group=grpMom)
macdSlow = input.int(26, "MACD Slow", group=grpMom)
macdSig  = input.int(9,  "MACD Signal", group=grpMom)

grpRmi = "🎯 RMI — Relative Momentum Index"
useRmiTrend = input.bool(true, "استخدام RMI لتأكيد قوة واتجاه الحركة", group=grpRmi, tooltip="RMI أنعم من RSI لأنه يقيس الزخم عبر عدة شموع بدل شمعة واحدة — مفيد لتقليل الإشارات الوهمية في أسهم EGX قليلة السيولة")
rmiLen      = input.int(14, "فترة تجانس RMI", minval=2, group=grpRmi)
rmiMomLen   = input.int(5, "فترة الزخم (Momentum Length)", minval=1, group=grpRmi)
rmiMid      = input.int(50, "خط المنتصف", minval=1, maxval=99, group=grpRmi)

grpStrength = "💪 قوة الاتجاه — ADX"
adxLen = input.int(14, "فترة ADX/DMI", group=grpStrength)
adxTh  = input.int(20, "حد أدنى لقوة الاتجاه", group=grpStrength, tooltip="لا تُصدر إشارات في الأسواق العرضية (Sideways) الضعيفة")

grpVol = "📊 الحجم — Volume"
volLen  = input.int(20, "متوسط الحجم", group=grpVol)
volMult = input.float(1.2, "معامل تأكيد الحجم", step=0.1, minval=0.5, group=grpVol, tooltip="يشترط حجم تداول أعلى من المتوسط لتأكيد الإشارة — مهم للأسهم قليلة السيولة بالبورصة المصرية")

grpRisk = "🛡️ إدارة المخاطر — Risk"
atrLen    = input.int(14, "فترة ATR", group=grpRisk)
rrRatio   = input.float(2.0, "نسبة العائد للمخاطرة R:R", step=0.1, minval=0.5, group=grpRisk)

grpStyle = "🎨 التصميم — Style"
showDashboard    = input.bool(true, "إظهار لوحة المعلومات", group=grpStyle)
showEma          = input.bool(false, "إظهار متوسطات EMA على الشارت", group=grpStyle)
showCloud        = input.bool(false, "إظهار سحابة الاتجاه EMA", group=grpStyle)
showBg           = input.bool(false, "تظليل خلفية الاتجاه", group=grpStyle)
showLevels       = input.bool(false, "إظهار خطوط الدخول / الوقف / الهدف", group=grpStyle)
showExitMarkers  = input.bool(false, "إظهار علامات الخروج على الشارت", group=grpStyle, tooltip="بيانات الخروج تظهر دائمًا في لوحة المعلومات بغض النظر عن هذا الخيار")
dashSize         = input.string("normal", "حجم لوحة المعلومات", options=["small", "normal", "large"], group=grpStyle)

grpZones = "🟩 مناطق العرض والطلب — Supply & Demand"
enableZones      = input.bool(true, "تفعيل تحليل مناطق العرض والطلب", group=grpZones, tooltip="التحليل يغذي لوحة المعلومات والفلاتر حتى لو الرسم على الشارت معطّل")
showZonesOnChart = input.bool(false, "رسم مناطق العرض والطلب على الشارت", group=grpZones)
zoneSwingLen     = input.int(5, "طول السوينج (Pivot)", minval=2, group=grpZones)
zoneDispMult     = input.float(1.5, "أدنى قوة اندفاع (× ATR)", step=0.1, minval=0.5, group=grpZones, tooltip="كلما زادت القيمة كلما قلّت المناطق وزادت قوتها")
zoneMaxCount     = input.int(6, "أقصى عدد مناطق نشطة لكل نوع", minval=1, maxval=20, group=grpZones)
zoneExtendBars   = input.int(60, "امتداد المنطقة (عدد شموع)", minval=5, group=grpZones)

grpFvg = "🌀 الفجوات السعرية — Fair Value Gaps"
enableFvg     = input.bool(true, "تفعيل تحليل الفجوات السعرية FVG", group=grpFvg)
showFvgOnChart = input.bool(false, "رسم الفجوات السعرية على الشارت", group=grpFvg)
fvgMinAtr     = input.float(0.25, "أدنى حجم للفجوة (× ATR)", step=0.05, minval=0, group=grpFvg, tooltip="يفلتر الفجوات الصغيرة غير المهمة")
fvgMaxCount   = input.int(10, "أقصى عدد فجوات نشطة لكل نوع", minval=1, maxval=30, group=grpFvg)
fvgExtendBars = input.int(40, "امتداد الفجوة (عدد شموع)", minval=5, group=grpFvg)

grpStruct = "🧭 هيكل السوق — Price Action (BOS/CHoCH)"
enableStructure      = input.bool(true, "تفعيل تحليل هيكل السوق", group=grpStruct)
showStructureOnChart = input.bool(false, "رسم علامات BOS / CHoCH على الشارت", group=grpStruct)
structSwingLen       = input.int(5, "طول السوينج للهيكل", minval=2, group=grpStruct)

grpSR = "📏 الدعم والمقاومة الرئيسية — Major Support & Resistance"
showSR       = input.bool(true, "إظهار مناطق الدعم والمقاومة الرئيسية", group=grpSR)
srSwingLen   = input.int(15, "طول السوينج (كشف القمم/القيعان الرئيسية)", minval=5, group=grpSR)
srMergeAtr   = input.float(1.0, "مسافة دمج المستويات المتقاربة (× ATR)", step=0.1, minval=0.1, group=grpSR, tooltip="المستويات القريبة من بعض بتتجمع كمستوى واحد أقوى بدل ما تتكرر")
srMaxLevels  = input.int(6, "أقصى عدد مستويات متتبَّعة", minval=1, maxval=15, group=grpSR)
srMinTouches = input.int(2, "أقل عدد لمسات لعرض المستوى", minval=1, group=grpSR, tooltip="ارفعها لعرض المستويات الأقوى فقط (الأكثر ملامسة من السعر عبر الزمن)")
srLineWidth  = input.int(1, "سُمك خط المستوى الأساسي", minval=1, maxval=4, group=grpSR)

grpFilter = "🔎 فلاتر تأكيد إضافية — Confluence Filters"
useZoneFilter    = input.bool(false, "اشتراط الدخول من منطقة عرض/طلب", group=grpFilter, tooltip="شراء فقط قرب منطقة طلب، وبيع فقط قرب منطقة عرض")
useFvgFilter     = input.bool(false, "اشتراط وجود فجوة سعرية داعمة", group=grpFilter)
useStructFilter  = input.bool(false, "اشتراط توافق هيكل السوق BOS/CHoCH", group=grpFilter)
zoneProximityAtr = input.float(0.5, "مسافة القرب من المنطقة (× ATR)", step=0.1, minval=0, group=grpFilter)
useEmaStackFilter = input.bool(false, "اشتراط ترتيب متوسطات EMA", group=grpFilter, tooltip="فلاتر تشديد اختيارية — كلها معطّلة افتراضيًا لأن إشارة الدخول أصبحت مبنية على بداية الشريط اللوني مباشرة")
useMacdFilter     = input.bool(false, "اشتراط توافق MACD", group=grpFilter)
useRsiFilter      = input.bool(false, "اشتراط نطاق RSI", group=grpFilter)
useAdxFilter      = input.bool(false, "اشتراط قوة اتجاه ADX", group=grpFilter)
useVolFilter      = input.bool(false, "اشتراط ارتفاع حجم التداول", group=grpFilter)

// ============================== PALETTE =====================================
colBullish   = #00E396
colBearish   = #FF4560
colGold      = #D4AF37
colGoldSoft  = #F5D06F
colTeal      = #17C3B2
colPanelBg   = #0D1321
colPanelBg2  = #131B2E
colGrey      = #7F8FA6

// ============================== CALCULATIONS =================================
emaFast = ta.ema(close, emaFastLen)
emaMed  = ta.ema(close, emaMedLen)
emaSlow = ta.ema(close, emaSlowLen)

[superTrend, superDir] = ta.supertrend(stFactor, stAtrLen)
trendUp   = superDir < 0
trendDown = superDir > 0
stFlipUp   = trendUp   and superDir[1] > 0
stFlipDown = trendDown and superDir[1] < 0

emaBullStack = emaFast > emaMed and emaMed > emaSlow
emaBearStack = emaFast < emaMed and emaMed < emaSlow

rsiVal = ta.rsi(close, rsiLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, macdFast, macdSlow, macdSig)

rmiUp   = ta.rma(math.max(close - close[rmiMomLen], 0), rmiLen)
rmiDown = ta.rma(math.max(close[rmiMomLen] - close, 0), rmiLen)
rmiVal  = rmiDown == 0 ? 100 : rmiUp == 0 ? 0 : 100 - (100 / (1 + rmiUp / rmiDown))
rmiBull = rmiVal > rmiMid
rmiBear = rmiVal < rmiMid

[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
strongTrend = adxVal > adxTh

volSma  = ta.sma(volume, volLen)
volConfirm = volume > volSma * volMult

atrVal = ta.atr(atrLen)

// ============================== TREND RIBBON (clean professional trend line) =================================
// Smooth HMA "spine" colored only when SuperTrend direction and RMI agree — a neutral gold
// tone shows up whenever the two disagree, flagging a weak/transitional trend at a glance.
// Entries are triggered the moment this ribbon flips color (start of a green/red segment).
ribbonBase   = ta.hma(close, ribbonLen)
ribbonBull   = trendUp   and (not useRmiTrend or rmiBull)
ribbonBear   = trendDown and (not useRmiTrend or rmiBear)
ribbonColor  = ribbonBull ? colBullish : ribbonBear ? colBearish : colGoldSoft
ribbonFlipBull = ribbonBull and not ribbonBull[1]
ribbonFlipBear = ribbonBear and not ribbonBear[1]

// ============================== SUPPLY & DEMAND ZONES =================================
var array<box> demandBoxes = array.new<box>()
var array<box> supplyBoxes = array.new<box>()

zonePivLow  = ta.pivotlow(zoneSwingLen, zoneSwingLen)
zonePivHigh = ta.pivothigh(zoneSwingLen, zoneSwingLen)

if enableZones and not na(zonePivLow)
    zPivIdx = bar_index - zoneSwingLen
    zTop = high[zoneSwingLen]
    zBot = low[zoneSwingLen]
    zDisp = (close - zonePivLow) / atrVal
    if zDisp > zoneDispMult
        zTag = zDisp > zoneDispMult * 2 ? " 💎" : zDisp > zoneDispMult * 1.5 ? " 🔥" : ""
        zBorderCol = showZonesOnChart ? color.new(colBullish, 20) : color.new(colBullish, 100)
        zBgCol     = showZonesOnChart ? color.new(colBullish, 85) : color.new(colBullish, 100)
        zTextCol   = showZonesOnChart ? color.new(colBullish, 0)  : color.new(colBullish, 100)
        dBox = box.new(zPivIdx, zTop, bar_index + zoneExtendBars, zBot, border_color=zBorderCol, bgcolor=zBgCol, border_width=1, text=showZonesOnChart ? "Demand" + zTag : "", text_size=size.tiny, text_color=zTextCol, text_halign=text.align_left, text_valign=text.align_bottom)
        array.unshift(demandBoxes, dBox)
        if array.size(demandBoxes) > zoneMaxCount
            box.delete(array.pop(demandBoxes))

if enableZones and not na(zonePivHigh)
    zPivIdx = bar_index - zoneSwingLen
    zTop = high[zoneSwingLen]
    zBot = low[zoneSwingLen]
    zDisp = (zonePivHigh - close) / atrVal
    if zDisp > zoneDispMult
        zTag = zDisp > zoneDispMult * 2 ? " 💎" : zDisp > zoneDispMult * 1.5 ? " 🔥" : ""
        zBorderCol = showZonesOnChart ? color.new(colBearish, 20) : color.new(colBearish, 100)
        zBgCol     = showZonesOnChart ? color.new(colBearish, 85) : color.new(colBearish, 100)
        zTextCol   = showZonesOnChart ? color.new(colBearish, 0)  : color.new(colBearish, 100)
        sBox = box.new(zPivIdx, zTop, bar_index + zoneExtendBars, zBot, border_color=zBorderCol, bgcolor=zBgCol, border_width=1, text=showZonesOnChart ? "Supply" + zTag : "", text_size=size.tiny, text_color=zTextCol, text_halign=text.align_left, text_valign=text.align_top)
        array.unshift(supplyBoxes, sBox)
        if array.size(supplyBoxes) > zoneMaxCount
            box.delete(array.pop(supplyBoxes))

if array.size(demandBoxes) > 0
    for i = array.size(demandBoxes) - 1 to 0
        b = array.get(demandBoxes, i)
        if close < box.get_bottom(b)
            box.set_border_color(b, color.new(colGrey, 70))
            box.set_bgcolor(b, color.new(colGrey, 94))
            array.remove(demandBoxes, i)

if array.size(supplyBoxes) > 0
    for i = array.size(supplyBoxes) - 1 to 0
        b = array.get(supplyBoxes, i)
        if close > box.get_top(b)
            box.set_border_color(b, color.new(colGrey, 70))
            box.set_bgcolor(b, color.new(colGrey, 94))
            array.remove(supplyBoxes, i)

// ============================== FAIR VALUE GAPS =================================
var array<box> bullFvgBoxes = array.new<box>()
var array<box> bearFvgBoxes = array.new<box>()

bullFvg = low > high[2] and (low - high[2]) > atrVal * fvgMinAtr
bearFvg = high < low[2] and (low[2] - high) > atrVal * fvgMinAtr

if enableFvg and bullFvg
    fTop = low
    fBot = high[2]
    fBorderCol = showFvgOnChart ? color.new(colTeal, 30) : color.new(colTeal, 100)
    fBgCol     = showFvgOnChart ? color.new(colTeal, 85) : color.new(colTeal, 100)
    fTextCol   = showFvgOnChart ? color.new(colTeal, 0)  : color.new(colTeal, 100)
    fBox = box.new(bar_index - 2, fTop, bar_index + fvgExtendBars, fBot, border_color=fBorderCol, bgcolor=fBgCol, border_width=1, border_style=line.style_dashed, text=showFvgOnChart ? "FVG" : "", text_size=size.tiny, text_color=fTextCol)
    array.unshift(bullFvgBoxes, fBox)
    if array.size(bullFvgBoxes) > fvgMaxCount
        box.delete(array.pop(bullFvgBoxes))

if enableFvg and bearFvg
    fTop = low[2]
    fBot = high
    fBorderCol = showFvgOnChart ? color.new(colBearish, 30) : color.new(colBearish, 100)
    fBgCol     = showFvgOnChart ? color.new(colBearish, 85) : color.new(colBearish, 100)
    fTextCol   = showFvgOnChart ? color.new(colBearish, 0)  : color.new(colBearish, 100)
    fBox = box.new(bar_index - 2, fTop, bar_index + fvgExtendBars, fBot, border_color=fBorderCol, bgcolor=fBgCol, border_width=1, border_style=line.style_dashed, text=showFvgOnChart ? "FVG" : "", text_size=size.tiny, text_color=fTextCol)
    array.unshift(bearFvgBoxes, fBox)
    if array.size(bearFvgBoxes) > fvgMaxCount
        box.delete(array.pop(bearFvgBoxes))

if array.size(bullFvgBoxes) > 0
    for i = array.size(bullFvgBoxes) - 1 to 0
        b = array.get(bullFvgBoxes, i)
        if close < box.get_bottom(b)
            box.set_bgcolor(b, color.new(colGrey, 95))
            box.set_border_color(b, color.new(colGrey, 75))
            array.remove(bullFvgBoxes, i)

if array.size(bearFvgBoxes) > 0
    for i = array.size(bearFvgBoxes) - 1 to 0
        b = array.get(bearFvgBoxes, i)
        if close > box.get_top(b)
            box.set_bgcolor(b, color.new(colGrey, 95))
            box.set_border_color(b, color.new(colGrey, 75))
            array.remove(bearFvgBoxes, i)

// ============================== MARKET STRUCTURE (PRICE ACTION) =================================
var float lastSwingHigh = na
var float lastSwingLow  = na
var int   structTrend   = 0

structPivHigh = ta.pivothigh(structSwingLen, structSwingLen)
structPivLow  = ta.pivotlow(structSwingLen, structSwingLen)

if not na(structPivHigh)
    lastSwingHigh := structPivHigh
if not na(structPivLow)
    lastSwingLow := structPivLow

bosUp   = enableStructure and not na(lastSwingHigh) and ta.crossover(close, lastSwingHigh)
bosDown = enableStructure and not na(lastSwingLow)  and ta.crossunder(close, lastSwingLow)

if bosUp
    if showStructureOnChart
        label.new(bar_index, low - atrVal * 0.9, structTrend <= 0 ? "CHoCH ▲" : "BOS ▲", style=label.style_label_up, color=color.new(colBullish, 70), textcolor=colBullish, size=size.tiny)
    structTrend := 1

if bosDown
    if showStructureOnChart
        label.new(bar_index, high + atrVal * 0.9, structTrend >= 0 ? "CHoCH ▼" : "BOS ▼", style=label.style_label_down, color=color.new(colBearish, 70), textcolor=colBearish, size=size.tiny)
    structTrend := -1

// ============================== MAJOR SUPPORT & RESISTANCE =================================
// Major swing highs/lows are tracked as levels; nearby levels merge together and gain a
// "touch count" — the more times price has respected a level, the thicker/stronger its line.
type SRLevel
    float price
    int   touches
    int   kind
    line  ln

var array<SRLevel> srLevels = array.new<SRLevel>()

srPivHigh = ta.pivothigh(srSwingLen, srSwingLen)
srPivLow  = ta.pivotlow(srSwingLen, srSwingLen)

srRegisterLevel(price, kind) =>
    mergeTol = atrVal * srMergeAtr
    matchedIdx = -1
    if array.size(srLevels) > 0
        for i = 0 to array.size(srLevels) - 1
            lvl = array.get(srLevels, i)
            if math.abs(lvl.price - price) <= mergeTol
                matchedIdx := i
    if matchedIdx >= 0
        lvl = array.get(srLevels, matchedIdx)
        lvl.touches := lvl.touches + 1
        lvl.price := (lvl.price + price) / 2
        if showSR and lvl.touches >= srMinTouches
            lvlColor = lvl.kind == 1 ? color.new(colBearish, 40) : color.new(colBullish, 40)
            lw = math.min(srLineWidth + lvl.touches - srMinTouches, srLineWidth + 3)
            if na(lvl.ln)
                lvl.ln := line.new(bar_index, lvl.price, bar_index, lvl.price, extend=extend.right, color=lvlColor, width=lw)
            else
                line.set_y1(lvl.ln, lvl.price)
                line.set_y2(lvl.ln, lvl.price)
                line.set_color(lvl.ln, lvlColor)
                line.set_width(lvl.ln, lw)
    else
        newLvl = SRLevel.new(price, 1, kind, na)
        array.push(srLevels, newLvl)
        if array.size(srLevels) > srMaxLevels
            weakIdx = 0
            weakTouches = array.get(srLevels, 0).touches
            for i = 1 to array.size(srLevels) - 1
                t = array.get(srLevels, i).touches
                if t < weakTouches
                    weakTouches := t
                    weakIdx := i
            weakLvl = array.get(srLevels, weakIdx)
            if not na(weakLvl.ln)
                line.delete(weakLvl.ln)
            array.remove(srLevels, weakIdx)
    matchedIdx

if not na(srPivHigh)
    srRegisterLevel(srPivHigh, 1)
if not na(srPivLow)
    srRegisterLevel(srPivLow, -1)

// ============================== CONFLUENCE FILTER HELPERS =================================
priceNearZone(arr, prox) =>
    found = false
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            b = array.get(arr, i)
            top = box.get_top(b) + prox
            bot = box.get_bottom(b) - prox
            if close <= top and close >= bot
                found := true
    found

fvgSupportsLong(arr) =>
    found = false
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            b = array.get(arr, i)
            if box.get_top(b) <= close
                found := true
    found

fvgSupportsShort(arr) =>
    found = false
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            b = array.get(arr, i)
            if box.get_bottom(b) >= close
                found := true
    found

zoneOkLong   = not useZoneFilter   or priceNearZone(demandBoxes, atrVal * zoneProximityAtr)
zoneOkShort  = not useZoneFilter   or priceNearZone(supplyBoxes, atrVal * zoneProximityAtr)
fvgOkLong    = not useFvgFilter    or fvgSupportsLong(bullFvgBoxes)
fvgOkShort   = not useFvgFilter    or fvgSupportsShort(bearFvgBoxes)
structOkLong = not useStructFilter or structTrend >= 0
structOkShort = not useStructFilter or structTrend <= 0

// ============================== SIGNAL ENGINE =================================
// Entry fires the moment the Trend Ribbon flips color (start of a new green/red segment).
// RMI is already baked into the ribbon's color via ribbonBull/ribbonBear. Everything else
// below is an optional extra filter, off by default, for traders who want a stricter engine.
longCond  = ribbonFlipBull and (not useEmaStackFilter or emaBullStack) and (not useMacdFilter or macdLine > macdSignal) and (not useRsiFilter or (rsiVal > 40 and rsiVal < rsiOB)) and (not useAdxFilter or strongTrend) and (not useVolFilter or volConfirm) and zoneOkLong and fvgOkLong and structOkLong
shortCond = ribbonFlipBear and (not useEmaStackFilter or emaBearStack) and (not useMacdFilter or macdLine < macdSignal) and (not useRsiFilter or (rsiVal < 60 and rsiVal > rsiOS)) and (not useAdxFilter or strongTrend) and (not useVolFilter or volConfirm) and zoneOkShort and fvgOkShort and structOkShort

var int   posDir       = 0
var float entryPrice   = na
var float stopLevel    = na
var float targetLevel  = na
var string exitReason  = ""
var float lastExitPrice = na

hitStopLong    = posDir == 1  and low  <= stopLevel
hitTargetLong  = posDir == 1  and high >= targetLevel
hitStopShort   = posDir == -1 and high >= stopLevel
hitTargetShort = posDir == -1 and low  <= targetLevel

exitLong  = posDir == 1  and (stFlipDown or hitStopLong or hitTargetLong)
exitShort = posDir == -1 and (stFlipUp   or hitStopShort or hitTargetShort)

if longCond and posDir != 1
    posDir := 1
    entryPrice := close
    stopLevel := superTrend
    targetLevel := close + (close - superTrend) * rrRatio

if shortCond and posDir != -1
    posDir := -1
    entryPrice := close
    stopLevel := superTrend
    targetLevel := close - (superTrend - close) * rrRatio

if exitLong
    exitReason := hitTargetLong ? "TP" : hitStopLong ? "SL" : "FLIP"
    lastExitPrice := close
    posDir := 0

if exitShort
    exitReason := hitTargetShort ? "TP" : hitStopShort ? "SL" : "FLIP"
    lastExitPrice := close
    posDir := 0

// ============================== PLOTTING (minimal by design) =================================
plot(showEma ? emaFast : na, "EMA Fast", color=color.new(colTeal, 25), linewidth=1)
plot(showEma ? emaMed  : na, "EMA Medium", color=color.new(colGold, 25), linewidth=1)
plot(showEma ? emaSlow : na, "EMA Slow", color=color.new(colGrey, 15), linewidth=2)

fillColor = trendUp ? color.new(colBullish, 88) : trendDown ? color.new(colBearish, 88) : color.new(colGrey, 95)
p1 = plot(showCloud ? emaFast : na, "cloud1", display=display.none)
p2 = plot(showCloud ? emaSlow : na, "cloud2", display=display.none)
fill(p1, p2, color = showCloud ? fillColor : na, title="اتجاه EMA")

plot(showSuperTrend ? superTrend : na, "SuperTrend", color = trendUp ? color.new(colBullish, 0) : color.new(colBearish, 0), linewidth=2, style=plot.style_linebr)

plot(showRibbon and ribbonGlow ? ribbonBase : na, "Ribbon Glow", color=color.new(ribbonColor, 70), linewidth=ribbonWidth + 4)
plot(showRibbon ? ribbonBase : na, "Trend Ribbon", color=ribbonColor, linewidth=ribbonWidth)

bgcolor(showBg ? (trendUp ? color.new(colBullish, 96) : trendDown ? color.new(colBearish, 96) : na) : na, title="خلفية الاتجاه")

// Entry markers fire at the start of each ribbon color segment — kept minimal on purpose,
// full detail lives in the dashboard
plotshape(longCond, title="Buy", style=shape.triangleup, location=location.belowbar, color=colBullish, size=size.small, text="Buy", textcolor=color.white)
plotshape(shortCond, title="Down", style=shape.triangledown, location=location.abovebar, color=colBearish, size=size.small, text="Down", textcolor=color.white)

if showExitMarkers and (exitLong or exitShort)
    exitColor = exitReason == "TP" ? colGold : exitReason == "SL" ? colBearish : colGrey
    exitY = exitLong ? high + atrVal * 0.4 : low - atrVal * 0.4
    label.new(bar_index, exitY, exitReason, style=label.style_label_left, color=color.new(exitColor, 10), textcolor=color.white, size=size.tiny)

// Risk levels (entry / stop / target) for the active trade
var line entryLine  = na
var line stopLine   = na
var line targetLine = na

if showLevels
    if longCond or shortCond
        line.delete(entryLine)
        line.delete(stopLine)
        line.delete(targetLine)
        entryLine  := line.new(bar_index, entryPrice, bar_index + 1, entryPrice, extend=extend.right, color=color.new(colGoldSoft, 40), style=line.style_dotted, width=1)
        stopLine   := line.new(bar_index, stopLevel, bar_index + 1, stopLevel, extend=extend.right, color=color.new(colBearish, 30), style=line.style_dashed, width=1)
        targetLine := line.new(bar_index, targetLevel, bar_index + 1, targetLevel, extend=extend.right, color=color.new(colBullish, 30), style=line.style_dashed, width=1)
    if posDir == 0 and (exitLong or exitShort)
        line.delete(entryLine)
        line.delete(stopLine)
        line.delete(targetLine)

// ============================== DASHBOARD =================================
tableSize = dashSize == "small" ? size.small : dashSize == "large" ? size.large : size.normal

if showDashboard
    var table dash = table.new(position.top_right, 2, 11, border_width=1)

    table.cell(dash, 0, 0, "EGX Pro Signals", text_color=colGoldSoft, bgcolor=colPanelBg, text_size=tableSize, text_halign=text.align_left)
    table.cell(dash, 1, 0, syminfo.ticker, text_color=color.white, bgcolor=colPanelBg, text_size=tableSize)

    table.merge_cells(dash, 0, 1, 1, 1)
    table.cell(dash, 0, 1, "Created By Arbah Markets", text_color=colGold, bgcolor=colPanelBg2, text_size=size.tiny, text_halign=text.align_center)

    trendTxt = trendUp ? "صاعد ▲" : trendDown ? "هابط ▼" : "محايد ●"
    trendCol = trendUp ? colBullish : trendDown ? colBearish : colGrey
    table.cell(dash, 0, 2, "الاتجاه", text_color=color.white, bgcolor=colPanelBg, text_size=tableSize, text_halign=text.align_left)
    table.cell(dash, 1, 2, trendTxt, text_color=trendCol, bgcolor=colPanelBg, text_size=tableSize)

    table.cell(dash, 0, 3, "قوة الاتجاه ADX", text_color=color.white, bgcolor=colPanelBg2, text_size=tableSize, text_halign=text.align_left)
    table.cell(dash, 1, 3, str.tostring(adxVal, "#.#") + (strongTrend ? " قوي" : " ضعيف"), text_color=strongTrend ? colGold : colGrey, bgcolor=colPanelBg2, text_size=tableSize)

    rsiCol = rsiVal > rsiOB ? colBearish : rsiVal < rsiOS ? colBullish : color.white
    table.cell(dash, 0, 4, "RSI", text_color=color.white, bgcolor=colPanelBg, text_size=tableSize, text_halign=text.align_left)
    table.cell(dash, 1, 4, str.tostring(rsiVal, "#.#"), text_color=rsiCol, bgcolor=colPanelBg, text_size=tableSize)

    rmiTxt = str.tostring(rmiVal, "#.#") + (rmiBull ? " صاعد" : rmiBear ? " هابط" : "")
    rmiCol = rmiBull ? colBullish : rmiBear ? colBearish : colGrey
    table.cell(dash, 0, 5, "RMI", text_color=color.white, bgcolor=colPanelBg2, text_size=tableSize, text_halign=text.align_left)
    table.cell(dash, 1, 5, rmiTxt, text_color=rmiCol, bgcolor=colPanelBg2, text_size=tableSize)

    table.cell(dash, 0, 6, "الحجم", text_color=color.white, bgcolor=colPanelBg, text_size=tableSize, text_halign=text.align_left)
    table.cell(dash, 1, 6, volConfirm ? "مرتفع ✓" : "عادي", text_color=volConfirm ? colGold : colGrey, bgcolor=colPanelBg, text_size=tableSize)

    posTxt = posDir == 1 ? "شراء ▲" : posDir == -1 ? "بيع ▼" : "لا توجد صفقة"
    posCol = posDir == 1 ? colBullish : posDir == -1 ? colBearish : colGrey
    table.cell(dash, 0, 7, "حالة الصفقة", text_color=color.white, bgcolor=colPanelBg2, text_size=tableSize, text_halign=text.align_left)
    table.cell(dash, 1, 7, posTxt, text_color=posCol, bgcolor=colPanelBg2, text_size=tableSize)

    table.cell(dash, 0, 8, "وقف الخسارة", text_color=color.white, bgcolor=colPanelBg, text_size=tableSize, text_halign=text.align_left)
    table.cell(dash, 1, 8, posDir != 0 ? str.tostring(stopLevel, format.mintick) : "—", text_color=colBearish, bgcolor=colPanelBg, text_size=tableSize)

    table.cell(dash, 0, 9, "الهدف", text_color=color.white, bgcolor=colPanelBg2, text_size=tableSize, text_halign=text.align_left)
    table.cell(dash, 1, 9, posDir != 0 ? str.tostring(targetLevel, format.mintick) : "—", text_color=colBullish, bgcolor=colPanelBg2, text_size=tableSize)

    structTxt = structTrend > 0 ? "صاعد ▲" : structTrend < 0 ? "هابط ▼" : "غير محدد"
    structCol = structTrend > 0 ? colBullish : structTrend < 0 ? colBearish : colGrey
    table.cell(dash, 0, 10, "هيكل السوق", text_color=color.white, bgcolor=colPanelBg, text_size=tableSize, text_halign=text.align_left)
    table.cell(dash, 1, 10, structTxt, text_color=structCol, bgcolor=colPanelBg, text_size=tableSize)

// ============================== ALERTS =================================
alertcondition(longCond, title="EGX Buy Signal", message="EGX Pro Signals: BUY {{ticker}} @ {{close}}")
alertcondition(shortCond, title="EGX Sell Signal", message="EGX Pro Signals: SELL {{ticker}} @ {{close}}")
alertcondition(exitLong or exitShort, title="EGX Exit Signal", message="EGX Pro Signals: EXIT {{ticker}} @ {{close}}")
