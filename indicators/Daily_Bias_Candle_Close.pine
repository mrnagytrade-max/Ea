//@version=6
// ============================================================================
//  Daily Bias | التحيز اليومي من إغلاقات الشموع  —  Created By Arbah Markets
//
//  التحيز لا يتحدد إلا بعد إغلاق شمعة اليوم، بمقارنتها بالشمعة السابقة:
//   1) إغلاق بالجسم تحت قاع الشمعة السابقة   → تحيز هابط
//      إغلاق بالجسم فوق قمة الشمعة السابقة   → تحيز صاعد
//   2) كسر القاع بالذيل والرجوع والإغلاق جواها → تحيز صاعد (سحب سيولة القاع)
//      كسر القمة بالذيل والرجوع والإغلاق جواها → تحيز هابط (سحب سيولة القمة)
//   3) كسر القمة والقاع بالذيل والإغلاق جوه    → لا يوجد تحيز
//      شمعة داخلية (لا كسر قمة ولا قاع)        → لا يوجد تحيز
//
//  طالما الشمعة لسه مفتوحة → "في انتظار الإغلاق ⏳" ولا يتم رسم أي نتيجة لها.
//  النتيجة تترسم على نفس الشمعة اللي قفلت، ومش بتتغير بعد كده (No Repaint).
// ============================================================================
indicator("Daily Bias | التحيز اليومي", shorttitle="Daily Bias", overlay=true, max_labels_count=500, max_boxes_count=500)

// ============================== INPUTS =====================================
grpMain   = "⚙️ الإعدادات — Settings"
biasTf    = input.timeframe("D", "فريم التحيز (Bias Timeframe)", group=grpMain)
showLines = input.bool(true, "عرض قمة/قاع آخر شمعة مقفولة", group=grpMain)
showBox   = input.bool(true, "تلوين الشمعة المقفولة حسب التحيز", group=grpMain)
showLbl   = input.bool(true, "عرض ملصق التحيز على الشمعة المقفولة", group=grpMain)
showTbl   = input.bool(true, "عرض لوحة التحيز", group=grpMain)
tblPos    = input.string("Top Right", "مكان اللوحة", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grpMain)

grpCol   = "🎨 الألوان — Colors"
bullCol  = input.color(color.new(#089981, 0), "صاعد", group=grpCol)
bearCol  = input.color(color.new(#F23645, 0), "هابط", group=grpCol)
neutCol  = input.color(color.new(#787B86, 0), "لا يوجد تحيز", group=grpCol)
bgTransp = input.int(85, "شفافية التلوين", minval=0, maxval=100, group=grpCol)

// ============================== LOGIC ======================================
// Case codes (candle vs the candle before it):
//   2 = body close above prior high (bull)       -2 = body close below prior low (bear)
//   1 = wick swept prior low, closed inside (bull) -1 = wick swept prior high, closed inside (bear)
//   0 = inside bar                                  3 = swept both sides, closed inside
caseCode() =>
    int c = 0
    if close > high[1]
        c := 2
    else if close < low[1]
        c := -2
    else
        bool tookHigh = high > high[1]
        bool tookLow  = low  < low[1]
        c := tookHigh and tookLow ? 3 : tookLow ? 1 : tookHigh ? -1 : 0
    c

codeToBias(int c) => c == 2 or c == 1 ? 1 : c == -2 or c == -1 ? -1 : 0

codeToReason(int c) =>
    switch c
        2  => "إغلاق بالجسم فوق قمة الشمعة السابقة"
        -2 => "إغلاق بالجسم تحت قاع الشمعة السابقة"
        1  => "كسر القاع بالذيل والإغلاق جوه الشمعة السابقة"
        -1 => "كسر القمة بالذيل والإغلاق جوه الشمعة السابقة"
        3  => "كسر القمة والقاع بالذيل والإغلاق جوه"
        => "شمعة داخلية — لم تكسر قمة ولا قاع"

// Live (still-forming) values of the bias-timeframe candle — NOT used until it closes
[liveCode, liveHigh, liveLow] = request.security(syminfo.tickerid, biasTf, [caseCode(), high, low], lookahead=barmerge.lookahead_off)

sameTf    = timeframe.in_seconds() == timeframe.in_seconds(biasTf)
newPeriod = timeframe.change(biasTf)

// Detect the moment a bias candle is CLOSED and capture its final values
bool  closedNow = false
int   cCode     = na
float cHigh     = na
float cLow      = na
int   cBar      = na
if sameTf
    // Chart is on the bias timeframe: evaluate only once the bar is confirmed
    if barstate.isconfirmed
        closedNow := true
        cCode := liveCode
        cHigh := liveHigh
        cLow  := liveLow
        cBar  := bar_index
else if newPeriod and bar_index > 0
    // Lower timeframe: the previous bias candle just closed → its final values are on bar [1]
    closedNow := true
    cCode := liveCode[1]
    cHigh := liveHigh[1]
    cLow  := liveLow[1]
    cBar  := bar_index - 1

// Persist the last CONFIRMED result
var int   lastCode  = na
var float lastHigh  = na
var float lastLow   = na
var int   periodBeg = na
var int   prevBeg   = na

if newPeriod
    prevBeg   := periodBeg
    periodBeg := bar_index

if closedNow and not na(cCode)
    lastCode := cCode
    lastHigh := cHigh
    lastLow  := cLow

    bias = codeToBias(cCode)
    col  = bias == 1 ? bullCol : bias == -1 ? bearCol : neutCol
    txt  = bias == 1 ? "▲ صاعد" : bias == -1 ? "▼ هابط" : "◆ لا تحيز"

    // Color the candle that just closed (whole day range on lower timeframes)
    if showBox
        int left = sameTf ? cBar : nz(prevBeg, cBar)
        box.new(left, cHigh, cBar, cLow, border_color=color.new(col, 40), bgcolor=color.new(col, bgTransp))
    if showLbl
        label.new(cBar, bias == -1 ? cHigh : cLow, txt,
             style=bias == -1 ? label.style_label_down : label.style_label_up,
             color=col, textcolor=color.white, size=size.small, tooltip=codeToReason(cCode))

lastBias = na(lastCode) ? 0 : codeToBias(lastCode)
lastCol  = lastBias == 1 ? bullCol : lastBias == -1 ? bearCol : neutCol
lastTxt  = na(lastCode) ? "—" : lastBias == 1 ? "صاعد ▲ BULLISH" : lastBias == -1 ? "هابط ▼ BEARISH" : "لا يوجد تحيز — NO BIAS"

// ============================== VISUALS ====================================
// High / low of the last CLOSED bias candle (levels the current candle is judged against)
plot(showLines and not newPeriod ? lastHigh : na, "Last Closed High", color=color.new(bullCol, 30), linewidth=1, style=plot.style_linebr)
plot(showLines and not newPeriod ? lastLow  : na, "Last Closed Low",  color=color.new(bearCol, 30), linewidth=1, style=plot.style_linebr)

var table tbl = table.new(tblPos == "Top Right" ? position.top_right : tblPos == "Top Left" ? position.top_left : tblPos == "Bottom Right" ? position.bottom_right : position.bottom_left,
     2, 4, border_width=1, border_color=color.new(color.gray, 60))

if showTbl and barstate.islast
    dark = color.new(#131722, 0)
    table.cell(tbl, 0, 0, "آخر تحيز مؤكد", text_color=color.white, bgcolor=dark, text_size=size.normal)
    table.cell(tbl, 1, 0, lastTxt, text_color=color.white, bgcolor=lastCol, text_size=size.normal)
    table.cell(tbl, 0, 1, "السبب", text_color=color.white, bgcolor=dark, text_size=size.small)
    table.cell(tbl, 1, 1, na(lastCode) ? "—" : codeToReason(lastCode), text_color=color.white, bgcolor=dark, text_size=size.small)
    table.cell(tbl, 0, 2, "قمة / قاع الشمعة المقفولة", text_color=color.white, bgcolor=dark, text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(lastHigh, format.mintick) + " / " + str.tostring(lastLow, format.mintick), text_color=color.white, bgcolor=dark, text_size=size.small)
    table.cell(tbl, 0, 3, "الشمعة الحالية", text_color=color.white, bgcolor=dark, text_size=size.small)
    table.cell(tbl, 1, 3, "في انتظار الإغلاق ⏳", text_color=color.white, bgcolor=color.new(#FF9800, 20), text_size=size.small)

// ============================== ALERTS =====================================
confirmedBias = closedNow and not na(cCode) ? codeToBias(cCode) : na
alertcondition(confirmedBias == 1,  "Bullish Bias Confirmed", "تم إغلاق الشمعة — التحيز صاعد ▲ {{ticker}}")
alertcondition(confirmedBias == -1, "Bearish Bias Confirmed", "تم إغلاق الشمعة — التحيز هابط ▼ {{ticker}}")
alertcondition(confirmedBias == 0,  "No Bias Confirmed",      "تم إغلاق الشمعة — لا يوجد تحيز {{ticker}}")
