//@version=6
// ============================================================================
//  PIPS FLOW  —  Fixed Range Volume Profile POC + Liquidity Sweep Signals
//  Made By Mohamed Nagui
//
//  1) Fixed Range Volume Profile : pick a range on the chart (Manual) or use
//     the previous completed period automatically (Auto: Day / Week / Month).
//     → POC, POC Zone, VAH / VAL + histogram drawn on the range itself.
//  2) Liquidity Sweep : price returns to the POC zone, wicks through the
//     recent swing liquidity (stops) and closes back.
//  3) Confirmation : a following candle closes beyond the sweep candle
//     (market-structure shift) → entry. Stop behind the sweep wick,
//     TP1 = 2R, TP2 = 3R, stop to break-even after TP1.
//  Trade data (Entry / SL / TP1 / TP2 + pips) is printed on every signal.
// ============================================================================
indicator("Pips Flow — FRVP POC + Liquidity Sweep | Made By Mohamed Nagui", shorttitle="Pips Flow", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ============================== INPUTS =====================================
grpRng = "📊 Fixed Range Volume Profile"
rngMode  = input.string("Manual (Pick on Chart)", "نوع الرينج", options=["Manual (Pick on Chart)", "Auto (Previous Period)"], group=grpRng, tooltip="Manual: حدد بداية ونهاية الرينج على الشارت زي أداة Fixed Range Volume Profile — الإشارات بتبدأ بعد نهاية الرينج.\nAuto: كل فترة جديدة بتاخد POC الفترة اللي قبلها (يوم/أسبوع/شهر) — بيدي إشارات على كل التاريخ")
rStart   = input.time(timestamp("2026-11-01T00:00:00"), "بداية الرينج (Manual)", confirm=true, group=grpRng)
rEnd     = input.time(timestamp("2026-11-05T00:00:00"), "نهاية الرينج (Manual)", confirm=true, group=grpRng)
autoTFIn = input.timeframe("", "فترة الرينج التلقائي (فاضي = تلقائي)", group=grpRng, tooltip="تلقائي: حتى 15m → يومي | 30m-1H → أسبوعي | 2H-4H → شهري | يومي فأكبر → 3 شهور")
vpRows   = input.int(50, "عدد مستويات البروفايل (Rows)", minval=10, maxval=120, group=grpRng)
vaPct    = input.float(70.0, "Value Area %", minval=50.0, maxval=95.0, group=grpRng) / 100.0
pocZnAtr = input.float(0.25, "نص عرض منطقة POC (× ATR)", minval=0.0, step=0.05, group=grpRng, tooltip="منطقة POC = POC ± القيمة دي (على الأقل نص ارتفاع صف البروفايل)")
showVP   = input.bool(true, "رسم هيستوجرام البروفايل على الرينج", group=grpRng)
vpWPct   = input.int(30, "عرض الهيستوجرام (% من الرينج)", minval=5, maxval=100, group=grpRng)
showVA   = input.bool(true, "إظهار VAH / VAL", group=grpRng)

grpLiq = "💧 سحب السيولة — Liquidity Sweep"
liqLen     = input.int(10, "فترة السيولة (قمم/قيعان آخر N شمعة)", minval=3, maxval=100, group=grpLiq)
sweepDepth = input.float(0.5, "أقصى عمق للسحب تحت/فوق منطقة POC (× ATR)", minval=0.0, step=0.1, group=grpLiq)
confMode   = input.string("Break of Sweep Candle", "التأكيد", options=["Break of Sweep Candle", "Instant (Sweep Candle Close)"], group=grpLiq, tooltip="Break of Sweep Candle: بعد السحب لازم شمعة تقفل فوق هاي (أو تحت لو) شمعة السحب — أدق.\nInstant: الدخول على إغلاق شمعة السحب نفسها لو قفلت قوية — أسرع واستوب أصغر")
confBars   = input.int(5, "أقصى عدد شموع لانتظار التأكيد", minval=1, maxval=30, group=grpLiq)
useVolF    = input.bool(true, "اشتراط فوليوم أعلى من المتوسط على شمعة السحب", group=grpLiq)
volMin     = input.float(1.0, "أقل فوليوم نسبي", minval=0.1, step=0.1, group=grpLiq)
showSweep  = input.bool(true, "إظهار علامة سحب السيولة", group=grpLiq)

grpSig = "🎯 الصفقة — Trade"
rrRatio  = input.float(2.0, "الهدف الأول TP1 (× الاستوب)", minval=1.0, step=0.25, group=grpSig)
tp2Ratio = input.float(3.0, "الهدف الثاني TP2 (× الاستوب)", minval=1.0, step=0.25, group=grpSig)
atrLen   = input.int(14, "ATR Length", minval=1, group=grpSig)
slBufAtr = input.float(0.10, "هامش الاستوب خلف ذيل السحب (× ATR)", minval=0.0, step=0.05, group=grpSig)
maxSlAtr = input.float(1.5, "أقصى حجم استوب (× ATR) — يلغي الإشارات الأوسع", minval=0.2, step=0.1, group=grpSig)
minSlAtr = input.float(0.30, "أقل حجم استوب (× ATR)", minval=0.05, step=0.05, group=grpSig)
oneTrade = input.bool(true, "صفقة واحدة في نفس الوقت", group=grpSig)
moveBE   = input.bool(true, "نقل الاستوب لنقطة الدخول بعد TP1", group=grpSig)
useHTF   = input.bool(false, "فلتر اتجاه الفريم الأكبر (EMA 50)", group=grpSig)
htfIn    = input.timeframe("", "الفريم الأكبر (فاضي = تلقائي)", group=grpSig)
useSess  = input.bool(false, "التداول في جلسات لندن + نيويورك فقط", group=grpSig)
sessLon  = input.session("0700-1600", "جلسة لندن (UTC)", group=grpSig)
sessNY   = input.session("1200-2100", "جلسة نيويورك (UTC)", group=grpSig)
calcBars = input.int(5000, "حساب على آخر N شمعة (Auto)", minval=300, maxval=20000, group=grpSig)

grpVis = "🎨 الشكل — Style"
cBull = input.color(#00E676, "شراء", group=grpVis)
cBear = input.color(#FF3D57, "بيع", group=grpVis)
cGold = input.color(#D4AF37, "ذهبي", group=grpVis)
cPOC  = input.color(#FFC400, "POC", group=grpVis)
lblSzIn = input.string("Small", "حجم ليبل الإشارة", options=["Tiny", "Small", "Normal"], group=grpVis)
pipIn = input.float(0.0, "حجم البيب (0 = تلقائي)", minval=0.0, group=grpVis, tooltip="تلقائي: الدهب 0.1 | الفوركس 10 تيك | غير كده تيك واحد")

grpDash = "🧾 الداشبورد — Dashboard"
showDash  = input.bool(true, "إظهار الداشبورد", group=grpDash)
dashPosIn = input.string("Top Right", "المكان", options=["Top Right", "Top Left", "Middle Right", "Bottom Right", "Bottom Left"], group=grpDash)
dashSzIn  = input.string("Small", "الحجم", options=["Tiny", "Small", "Normal"], group=grpDash)

// ============================== CORE =======================================
atr    = ta.atr(atrLen)
vol    = nz(volume)
volSma = ta.sma(vol, 20)
relVol = volSma > 0 ? vol / volSma : 0.0
rng    = high - low
tfSec  = timeframe.in_seconds()
hasVol = ta.cum(vol) > 0
isAuto = rngMode == "Auto (Previous Period)"
inCalc = not isAuto or bar_index >= last_bar_index - calcBars

isGold = str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD")
pip    = pipIn > 0 ? pipIn : isGold ? 0.1 : syminfo.type == "forex" ? syminfo.mintick * 10 : syminfo.mintick

// Liquidity (previous N bars, excluding the current one)
float liqLow    = ta.lowest(low, liqLen)[1]
float liqHigh   = ta.highest(high, liqLen)[1]
int   liqLowOf  = ta.lowestbars(low, liqLen)[1]
int   liqHighOf = ta.highestbars(high, liqLen)[1]
float recHiC    = ta.highest(close, liqLen)[1]
float recLoC    = ta.lowest(close, liqLen)[1]
float liqLowNow  = ta.lowest(low, liqLen)
float liqHighNow = ta.highest(high, liqLen)
float closePos  = rng > 0 ? (close - low) / rng : 0.5

// HTF bias (non-repainting)
string htfAuto = tfSec <= 60 ? "15" : tfSec <= 900 ? "60" : tfSec <= 3600 ? "240" : tfSec <= 14400 ? "D" : tfSec <= 86400 ? "W" : "M"
string htfTF   = htfIn == "" ? htfAuto : htfIn
[htfC, htfE] = request.security(syminfo.tickerid, htfTF, [close[1], ta.ema(close, 50)[1]], lookahead=barmerge.lookahead_on)
bool htfBull = htfC > htfE
bool htfBear = htfC < htfE

bool inLon  = not na(time(timeframe.period, sessLon, "UTC"))
bool inNY   = not na(time(timeframe.period, sessNY, "UTC"))
bool inSess = not useSess or not timeframe.isintraday or inLon or inNY

// ======================= FIXED RANGE VOLUME PROFILE ========================
string autoTF   = tfSec <= 900 ? "D" : tfSec <= 3600 ? "W" : tfSec <= 14400 ? "M" : "3M"
string periodTF = autoTFIn == "" ? autoTF : autoTFIn
bool   newPeriod = timeframe.change(periodTF)

var array<float> aH = array.new_float()
var array<float> aL = array.new_float()
var array<float> aV = array.new_float()
var array<int>   aB = array.new_int()
var array<float> vpVol = array.new_float(vpRows, 0.0)

var float zPoc   = na
var float zTop   = na
var float zBot   = na
var float vah    = na
var float val    = na
var float pRowH  = na
var float pBase  = na
var int   pIdx   = 0
var int   pUp    = 0
var int   pDn    = 0
var int   pStart = na
var int   pEnd   = na
var bool  rangeDone = false

f_profile() =>
    float hi   = aH.max()
    float lo   = aL.min()
    float rowH = (hi - lo) / vpRows
    array.fill(vpVol, 0.0)
    float rPoc = na
    float rVah = na
    float rVal = na
    int   pi   = 0
    int   up   = 0
    int   dn   = 0
    if rowH > 0
        for i = 0 to aH.size() - 1
            float h  = aH.get(i)
            float l  = aL.get(i)
            float v  = aV.get(i)
            int   r0 = math.max(0, math.min(vpRows - 1, math.floor((l - lo) / rowH)))
            int   r1 = math.max(0, math.min(vpRows - 1, math.floor((h - lo) / rowH)))
            int   n  = r1 - r0 + 1
            for r = r0 to r1
                array.set(vpVol, r, array.get(vpVol, r) + v / n)
        float mx = array.max(vpVol)
        if mx > 0
            pi := array.indexof(vpVol, mx)
            float target = array.sum(vpVol) * vaPct
            float acc    = array.get(vpVol, pi)
            up := pi
            dn := pi
            while acc < target and (up < vpRows - 1 or dn > 0)
                float vU = up < vpRows - 1 ? array.get(vpVol, up + 1) : -1.0
                float vD = dn > 0 ? array.get(vpVol, dn - 1) : -1.0
                if vU >= vD
                    up  += 1
                    acc += vU
                else
                    dn  -= 1
                    acc += vD
            rPoc := lo + rowH * (pi + 0.5)
            rVah := lo + rowH * (up + 1)
            rVal := lo + rowH * dn
    [rPoc, rVah, rVal, rowH, lo, pi, up, dn]

var array<box> vpBoxes = array.new<box>()
f_drawProfile() =>
    for b in vpBoxes
        box.delete(b)
    array.clear(vpBoxes)
    float mxv = array.max(vpVol)
    if showVP and mxv > 0 and not na(pStart)
        int span = math.max(1, pEnd - pStart + 1)
        int wMax = math.max(3, int(math.round(span * vpWPct / 100.0)))
        for r = 0 to vpRows - 1
            float v = array.get(vpVol, r)
            int   w = int(math.round(wMax * v / mxv))
            if w > 0
                float yb = pBase + pRowH * r
                bool  isP = r == pIdx
                bool  inV = r >= pDn and r <= pUp
                color bc  = isP ? color.new(cPOC, 15) : inV ? color.new(cGold, 60) : color.new(color.gray, 78)
                vpBoxes.push(box.new(pStart, yb + pRowH, pStart + w, yb, border_color=color.new(color.black, 100), bgcolor=bc))
        vpBoxes.push(box.new(pStart, pBase + pRowH * vpRows, pEnd, pBase, border_color=color.new(cGold, 70), border_style=line.style_dotted, bgcolor=color.new(cGold, 97)))

f_push() =>
    aH.push(high)
    aL.push(low)
    aV.push(vol)
    aB.push(bar_index)
    if aH.size() > 20000
        aH.shift()
        aL.shift()
        aV.shift()
        aB.shift()

bool doCompute = false
if isAuto
    if newPeriod and aH.size() > 0 and inCalc
        doCompute := true
    if not newPeriod
        f_push()
else
    bool inRange = time >= rStart and time <= rEnd
    if inRange
        f_push()
    if not rangeDone and time > rEnd and aH.size() > 0
        doCompute := true
        rangeDone := true
    else if not rangeDone and inRange and barstate.islast
        doCompute := true    // range still forming: preview only, no signals yet

if doCompute
    [p, h, l, rh, lo, pi, up, dn] = f_profile()
    if not na(p)
        float half = math.max(rh / 2, pocZnAtr * atr)
        zPoc   := p
        zTop   := p + half
        zBot   := p - half
        vah    := h
        val    := l
        pRowH  := rh
        pBase  := lo
        pIdx   := pi
        pUp    := up
        pDn    := dn
        pStart := aB.first()
        pEnd   := aB.last()
        f_drawProfile()
    if isAuto
        rangeDone := true

if isAuto and newPeriod
    aH.clear()
    aL.clear()
    aV.clear()
    aB.clear()
    f_push()

bool zoneOk = not na(zPoc) and rangeDone

pPocTop = plot(zoneOk ? zTop : na, "POC Zone Top", color=color.new(cPOC, 70), style=plot.style_stepline)
pPocBot = plot(zoneOk ? zBot : na, "POC Zone Bottom", color=color.new(cPOC, 70), style=plot.style_stepline)
fill(pPocTop, pPocBot, color=color.new(cPOC, 82), title="POC Zone")
plot(zoneOk ? zPoc : na, "POC", color=cPOC, linewidth=2, style=plot.style_stepline)
plot(zoneOk and showVA ? vah : na, "VAH", color=color.new(cGold, 45), style=plot.style_stepline)
plot(zoneOk and showVA ? val : na, "VAL", color=color.new(cGold, 45), style=plot.style_stepline)

// ============================== TRADE MANAGER ==============================
var int    tDir    = 0
var float  tEntry  = na
var float  tSL     = na
var float  tTP1    = na
var float  tTP2    = na
var int    tBar    = na
var bool   tTp1Hit = false
var string tStatus = "Waiting for setup"
var color  tStCol  = color.gray
var int    wins    = 0
var int    losses  = 0
var int    tp2Hits = 0
var string lastSig = "—"
var color  lastCol = color.gray
var box    tRiskBx = na
var box    tRewBx  = na
var line   tTp2Ln  = na
var array<box> histBoxes = array.new<box>()

f_closeTrade() =>
    if not na(tRiskBx)
        box.set_right(tRiskBx, bar_index)
    if not na(tRewBx)
        box.set_right(tRewBx, bar_index)
    if not na(tTp2Ln)
        line.set_x2(tTp2Ln, bar_index)

if tDir != 0 and bar_index > tBar
    bool hitSL  = tDir == 1 ? low <= tSL : high >= tSL
    bool hitTP1 = tDir == 1 ? high >= tTP1 : low <= tTP1
    bool hitTP2 = tDir == 1 ? high >= tTP2 : low <= tTP2
    if not tTp1Hit
        if hitSL
            losses  += 1
            tStatus := "❌ Stop Loss"
            tStCol  := cBear
            f_closeTrade()
            tDir    := 0
        else if hitTP1
            wins    += 1
            tTp1Hit := true
            tStatus := "✅ TP1 Hit" + (moveBE ? " — SL @ BE" : "")
            tStCol  := cBull
            if moveBE
                tSL := tEntry
            if hitTP2
                tp2Hits += 1
                tStatus := "🏆 TP2 Hit"
                tStCol  := cGold
                f_closeTrade()
                tDir    := 0
    else
        if hitTP2
            tp2Hits += 1
            tStatus := "🏆 TP2 Hit"
            tStCol  := cGold
            f_closeTrade()
            tDir    := 0
        else if hitSL
            tStatus := moveBE ? "🔒 Closed @ BE (TP1 secured)" : "✅ TP1 secured — SL hit"
            tStCol  := cGold
            f_closeTrade()
            tDir    := 0
    if tDir != 0
        if not na(tRiskBx)
            box.set_right(tRiskBx, bar_index + 1)
        if not na(tRewBx)
            box.set_right(tRewBx, bar_index + 1)
        if not na(tTp2Ln)
            line.set_x2(tTp2Ln, bar_index + 1)

// ============================== SIGNAL ENGINE ==============================
var int    pDir   = 0       // pending sweep direction awaiting confirmation
var float  pExt   = na      // sweep extreme (stop anchor)
var float  pTrig  = na      // confirmation level
var int    pBar   = na
var string setupTxt = "Waiting for price at POC"
var color  setupCol = color.gray

bool  canTrade = not oneTrade or tDir == 0
bool  baseOk   = zoneOk and inCalc and barstate.isconfirmed and atr > 0
float tol      = 0.10 * atr
bool  volOk    = not useVolF or relVol >= volMin
bool  instant  = confMode == "Instant (Sweep Candle Close)"

bool sweepLong  = baseOk and low < liqLow and close > liqLow and low <= zTop + tol and low >= zBot - sweepDepth * atr and close > zBot and recHiC > zTop and volOk
bool sweepShort = baseOk and not sweepLong and high > liqHigh and close < liqHigh and high >= zBot - tol and high <= zTop + sweepDepth * atr and close < zTop and recLoC < zBot and volOk

bool  longSig  = false
bool  shortSig = false
float sigExt   = na

if baseOk
    // ---- resolve pending sweep ----
    if pDir == 1
        if low < pExt
            pDir := 0
            setupTxt := "Sweep failed (new low)"
            setupCol := color.gray
        else if close > pTrig
            longSig := true
            sigExt  := pExt
            pDir    := 0
        else if bar_index - pBar >= confBars
            pDir := 0
            setupTxt := "Sweep expired — no confirmation"
            setupCol := color.gray
    else if pDir == -1
        if high > pExt
            pDir := 0
            setupTxt := "Sweep failed (new high)"
            setupCol := color.gray
        else if close < pTrig
            shortSig := true
            sigExt   := pExt
            pDir     := 0
        else if bar_index - pBar >= confBars
            pDir := 0
            setupTxt := "Sweep expired — no confirmation"
            setupCol := color.gray
    // ---- new sweep ----
    if not longSig and not shortSig
        if sweepLong
            if showSweep
                label.new(bar_index, low, "💧", yloc=yloc.belowbar, style=label.style_none, size=size.small, tooltip="Sell-side liquidity swept at POC zone")
                line.new(bar_index - 1 + liqLowOf, liqLow, bar_index, liqLow, color=color.new(cBull, 30), style=line.style_dotted)
            if instant
                if closePos >= 0.5 and close > open
                    longSig := true
                    sigExt  := low
            else
                pDir  := 1
                pExt  := low
                pTrig := high
                pBar  := bar_index
                setupTxt := "💧 Sell-side swept @ POC — wait close > " + str.tostring(high, format.mintick)
                setupCol := cBull
        else if sweepShort
            if showSweep
                label.new(bar_index, high, "💧", yloc=yloc.abovebar, style=label.style_none, size=size.small, tooltip="Buy-side liquidity swept at POC zone")
                line.new(bar_index - 1 + liqHighOf, liqHigh, bar_index, liqHigh, color=color.new(cBear, 30), style=line.style_dotted)
            if instant
                if closePos <= 0.5 and close < open
                    shortSig := true
                    sigExt   := high
            else
                pDir  := -1
                pExt  := high
                pTrig := low
                pBar  := bar_index
                setupTxt := "💧 Buy-side swept @ POC — wait close < " + str.tostring(low, format.mintick)
                setupCol := cBear

// ---- filters + stop sizing ----
float sigSL = na
float risk  = na
if longSig or shortSig
    int d = longSig ? 1 : -1
    sigSL := d == 1 ? sigExt - slBufAtr * atr : sigExt + slBufAtr * atr
    risk  := math.abs(close - sigSL)
    if risk < minSlAtr * atr
        risk  := minSlAtr * atr
        sigSL := close - d * risk
    bool htfOk = not useHTF or (d == 1 ? htfBull : htfBear)
    if risk > maxSlAtr * atr or not htfOk or not inSess or not canTrade
        setupTxt := risk > maxSlAtr * atr ? "Skipped — stop too wide" : not htfOk ? "Skipped — against HTF trend" : not inSess ? "Skipped — outside session" : "Skipped — trade already running"
        setupCol := color.gray
        longSig  := false
        shortSig := false

f_pips(float x) =>
    str.tostring(math.abs(x) / pip, "#.0")

f_px(float x) =>
    str.tostring(x, format.mintick)

lblSz = lblSzIn == "Tiny" ? size.tiny : lblSzIn == "Normal" ? size.normal : size.small

if longSig or shortSig
    float t1  = longSig ? close + rrRatio * risk : close - rrRatio * risk
    float t2  = longSig ? close + tp2Ratio * risk : close - tp2Ratio * risk
    color col = longSig ? cBull : cBear
    if tDir != 0
        f_closeTrade()
    tDir    := longSig ? 1 : -1
    tEntry  := close
    tSL     := sigSL
    tTP1    := t1
    tTP2    := t2
    tBar    := bar_index
    tTp1Hit := false
    tStatus := longSig ? "🟢 BUY Running" : "🔴 SELL Running"
    tStCol  := col
    lastSig := longSig ? "BUY ▲  (POC Sweep)" : "SELL ▼  (POC Sweep)"
    lastCol := col
    setupTxt := "Signal fired — managing trade"
    setupCol := col
    tRiskBx := box.new(bar_index, longSig ? close : sigSL, bar_index + 1, longSig ? sigSL : close, border_color=color.new(cBear, 60), bgcolor=color.new(cBear, 82))
    tRewBx  := box.new(bar_index, longSig ? t1 : close, bar_index + 1, longSig ? close : t1, border_color=color.new(cBull, 60), bgcolor=color.new(cBull, 82))
    tTp2Ln  := line.new(bar_index, t2, bar_index + 1, t2, color=color.new(cBull, 25), style=line.style_dashed)
    histBoxes.push(tRiskBx)
    histBoxes.push(tRewBx)
    while histBoxes.size() > 200
        box.delete(histBoxes.shift())
    string info = "Entry: " + f_px(close) + "\nSL: " + f_px(sigSL) + "  (" + f_pips(risk) + " p)\nTP1: " + f_px(t1) + "  (" + f_pips(t1 - close) + " p)\nTP2: " + f_px(t2) + "  (" + f_pips(t2 - close) + " p)"
    if longSig
        label.new(bar_index, low, "BUY ▲\n" + info, yloc=yloc.belowbar, style=label.style_label_up, color=cBull, textcolor=#0B0F19, size=lblSz, textalign=text.align_left)
    else
        label.new(bar_index, high, "SELL ▼\n" + info, yloc=yloc.abovebar, style=label.style_label_down, color=cBear, textcolor=color.white, size=lblSz, textalign=text.align_left)
    alert("Pips Flow " + (longSig ? "BUY" : "SELL") + " " + syminfo.ticker + " [" + timeframe.period + "] POC Liquidity Sweep | Entry " + f_px(close) + " | SL " + f_px(sigSL) + " | TP1 " + f_px(t1) + " | TP2 " + f_px(t2), alert.freq_once_per_bar_close)

alertcondition(longSig, "Pips Flow — BUY", "Pips Flow BUY {{ticker}} @ {{close}}")
alertcondition(shortSig, "Pips Flow — SELL", "Pips Flow SELL {{ticker}} @ {{close}}")
alertcondition(longSig or shortSig, "Pips Flow — Any Signal", "Pips Flow signal {{ticker}} @ {{close}}")

// ---- live price tags for the running trade ----
var array<label> tags = array.new<label>()
if barstate.islast
    for t in tags
        label.delete(t)
    array.clear(tags)
    if tDir != 0
        int xr = bar_index + 3
        tags.push(label.new(xr, tTP2, "TP2  " + f_px(tTP2) + "  (" + f_pips(tTP2 - tEntry) + " p)", style=label.style_label_left, color=color.new(cBull, 30), textcolor=color.white, size=size.tiny))
        tags.push(label.new(xr, tTP1, "TP1  " + f_px(tTP1) + "  (" + f_pips(tTP1 - tEntry) + " p)", style=label.style_label_left, color=cBull, textcolor=#0B0F19, size=size.tiny))
        tags.push(label.new(xr, tEntry, "ENTRY  " + f_px(tEntry), style=label.style_label_left, color=cGold, textcolor=#0B0F19, size=size.tiny))
        tags.push(label.new(xr, tSL, "SL  " + f_px(tSL) + "  (" + f_pips(tSL - tEntry) + " p)", style=label.style_label_left, color=cBear, textcolor=color.white, size=size.tiny))

// ================================ DASHBOARD ================================
cBg   = #0B0F19
cRowA = #111827
cRowB = #0E1420
cDim  = #9CA3AF
dashPos = dashPosIn == "Top Left" ? position.top_left : dashPosIn == "Middle Right" ? position.middle_right : dashPosIn == "Bottom Right" ? position.bottom_right : dashPosIn == "Bottom Left" ? position.bottom_left : position.top_right
tsz     = dashSzIn == "Tiny" ? size.tiny : dashSzIn == "Normal" ? size.normal : size.small

var table dash = table.new(dashPos, 2, 21, bgcolor=cBg, frame_color=cGold, frame_width=2, border_color=#1F2937, border_width=1)

f_row(int r, string k, string v, color vc) =>
    color bg = r % 2 == 0 ? cRowA : cRowB
    table.cell(dash, 0, r, k, text_color=cDim, text_size=tsz, text_halign=text.align_left, bgcolor=bg)
    table.cell(dash, 1, r, v, text_color=vc, text_size=tsz, text_halign=text.align_right, bgcolor=bg)

f_head(int r, string txt, color tc, string sz) =>
    table.cell(dash, 0, r, txt, text_color=tc, text_size=sz, text_halign=text.align_center, bgcolor=#05070D)
    table.merge_cells(dash, 0, r, 1, r)

if showDash and barstate.islast
    string locTxt = not zoneOk ? (isAuto ? "Waiting first period" : "Range not finished") : close > zTop ? "▲ Above POC Zone" : close < zBot ? "▼ Below POC Zone" : "◆ Inside POC Zone"
    color  locCol = not zoneOk ? cDim : close > zTop ? cBull : close < zBot ? cBear : cPOC
    f_head(0, "⚡ PIPS FLOW ⚡", cGold, tsz == size.tiny ? size.small : size.normal)
    f_head(1, "Fixed Range POC  •  Liquidity Sweep", cDim, size.tiny)
    f_row(2, "Symbol", syminfo.ticker + "  •  " + timeframe.period, color.white)
    f_row(3, "Range", isAuto ? "Auto — Previous " + periodTF : "Manual Fixed Range", cGold)
    f_row(4, "POC", zoneOk ? f_px(zPoc) : "—", cPOC)
    f_row(5, "POC Zone", zoneOk ? f_px(zBot) + "  —  " + f_px(zTop) : "—", cPOC)
    f_row(6, "Value Area", zoneOk ? f_px(val) + "  —  " + f_px(vah) : "—", cGold)
    f_row(7, "Price Location", locTxt, locCol)
    f_row(8, "Sell-side Liquidity", f_px(liqLowNow), cBull)
    f_row(9, "Buy-side Liquidity", f_px(liqHighNow), cBear)
    f_row(10, "Setup", setupTxt, setupCol)
    f_head(11, "━━━━  TRADE  ━━━━", cGold, size.tiny)
    f_row(12, "Last Signal", lastSig, lastCol)
    f_row(13, "Entry", na(tEntry) ? "—" : f_px(tEntry), cGold)
    f_row(14, "Stop Loss", na(tSL) ? "—" : f_px(tSL) + "  (" + f_pips(tSL - tEntry) + " p)", cBear)
    f_row(15, "TP1  (" + str.tostring(rrRatio, "#.##") + "R)", na(tTP1) ? "—" : f_px(tTP1) + "  (" + f_pips(tTP1 - tEntry) + " p)", cBull)
    f_row(16, "TP2  (" + str.tostring(tp2Ratio, "#.##") + "R)", na(tTP2) ? "—" : f_px(tTP2) + "  (" + f_pips(tTP2 - tEntry) + " p)", cBull)
    f_row(17, "Status", tStatus, tStCol)
    int closedTr = wins + losses
    f_row(18, "Win Rate (TP1)", closedTr > 0 ? str.tostring(math.round(100.0 * wins / closedTr)) + "%  (" + str.tostring(wins) + "W / " + str.tostring(losses) + "L • TP2 " + str.tostring(tp2Hits) + ")" : "—", closedTr > 0 and wins >= losses ? cBull : cDim)
    f_row(19, "Volume Data", hasVol ? "✔ OK" : "⚠ No volume — use OANDA / FOREXCOM", hasVol ? cBull : cBear)
    f_head(20, "Made By Mohamed Nagui", cGold, tsz)
